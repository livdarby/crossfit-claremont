<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section id="contact-map" class="section color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div
    class="map-section spacing-style section-content-wrapper"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="map-section__content">
      <div class="map-section__panel">
        {% if section.settings.kicker != blank %}
          <p class="map-section__kicker">{{ section.settings.kicker }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="map-section__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="map-section__text rte">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.location_name != blank %}
          <p class="map-section__location-name">{{ section.settings.location_name }}</p>
        {% endif %}

        {% if section.settings.address != blank %}
          <div class="map-section__details">
            <div class="map-section__address rte">
              {{ section.settings.address }}
            </div>

            {% if section.settings.email != blank or section.settings.phone != blank %}
              <div class="map-section__contact">
                {% if section.settings.email != blank %}
                  <p class="map-section__contact-row">
                    <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
                  </p>
                {% endif %}

                {% if section.settings.phone != blank %}
                  {% assign phone_href = section.settings.phone | replace: ' ', '' %}
                  <p class="map-section__contact-row">
                    <a href="tel:{{ phone_href }}">{{ section.settings.phone }}</a>
                  </p>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.directions_url != blank and section.settings.button_label != blank %}
          <a
            class="map-section__button button-secondary"
            href="{{ section.settings.directions_url }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>

      <div class="map-section__map-wrapper">
        {% if section.settings.embed_url != blank %}
          <iframe
            class="map-section__map"
            src="{{ section.settings.embed_url | escape }}"
            width="100%"
            height="{{ section.settings.map_height }}"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            title="{{ section.settings.location_name | default: section.settings.heading | escape }}"
          ></iframe>
        {% else %}
          <div class="map-section__placeholder" style="min-height: {{ section.settings.map_height }}px;">
            <div class="map-section__placeholder-card">
              <p class="map-section__placeholder-title">Google Map Placeholder</p>
              <p class="map-section__placeholder-text">
                Add a Google Maps embed URL in this section to display the gym location here.
              </p>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  #contact-map {
    scroll-margin-top: calc(var(--header-height, 60px) + 16px);
  }

  .map-section {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .map-section__content {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  .map-section__panel {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .map-section__kicker {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #530678;
  }

  .map-section__heading {
    margin: 0;
    font-family: 'Oswald';
    font-size: 32px;
    line-height: 1;
    font-weight: 500;
    color: var(--color-foreground-heading);
  }

  .map-section__text,
  .map-section__address,
  .map-section__contact {
    font-size: 14px;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.78);
  }

  .map-section__details {
    display: grid;
    gap: 1rem;
  }

  .map-section__text p,
  .map-section__address p {
    margin: 0 0 0.8rem;
  }

  .map-section__text p:last-child,
  .map-section__address p:last-child {
    margin-bottom: 0;
  }

  .map-section__contact-row {
    margin: 0;
  }

  .map-section__contact a {
    color: inherit;
    text-decoration: none;
  }

  .map-section__contact a:hover {
    color: #530678;
  }

  .map-section__location-name {
    margin: 0.2rem 0 0;
    font-family: 'Oswald';
    font-size: 22px;
    line-height: 1.05;
    font-weight: 500;
    color: var(--color-foreground-heading);
  }

  .map-section__button {
    align-self: flex-start;
    min-height: auto !important;
    margin-top: 0.3rem;
    padding: 0.45rem 0.7rem;
    line-height: 1.2;
    box-shadow: none;
    --button-color: #530678;
    --button-border-color: #530678;
  }

  .map-section__map-wrapper {
    overflow: hidden;
    border-radius: 14px;
    background: #ddd7cd;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .map-section__map {
    display: block;
  }

  .map-section__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background:
      linear-gradient(0deg, rgb(255 255 255 / 0.75), rgb(255 255 255 / 0.75)),
      linear-gradient(90deg, #e5e0d7 0 1px, transparent 1px 100%),
      linear-gradient(#e5e0d7 0 1px, transparent 1px 100%);
    background-size: auto, 24px 24px, 24px 24px;
    background-position: center;
  }

  .map-section__placeholder-card {
    max-width: 280px;
    padding: 1rem 1.1rem;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.92);
    box-shadow: 0 12px 24px rgb(0 0 0 / 0.08);
    text-align: center;
  }

  .map-section__placeholder-title {
    margin: 0 0 0.45rem;
    font-family: 'Oswald';
    font-size: 24px;
    line-height: 1;
    font-weight: 500;
  }

  .map-section__placeholder-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: rgb(38 38 38 / 0.72);
  }

  @media screen and (min-width: 750px) {
    .map-section__content {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.35fr);
      gap: 2rem;
    }

    .map-section__details {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      align-items: start;
    }

    .map-section__heading {
      font-size: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Map",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Visit us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find CrossFit Claremont"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Use the map to find the gym and open directions in Google Maps.</p>"
    },
    {
      "type": "text",
      "id": "location_name",
      "label": "Location name",
      "default": "CrossFit Claremont"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address",
      "default": "<p>1 Graylands Road<br/>Claremont WA 6010<br/>Australia</p>"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@crossfitclaremont.com.au"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "(08) 9384 4878"
    },
    {
      "type": "url",
      "id": "embed_url",
      "label": "Google Maps embed URL"
    },
    {
      "type": "url",
      "id": "directions_url",
      "label": "Directions link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get Directions"
    },
    {
      "type": "range",
      "id": "map_height",
      "label": "Map height",
      "min": 280,
      "max": 640,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Map"
    }
  ]
}
{% endschema %}
