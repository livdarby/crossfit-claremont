{%- stylesheet -%}
  .homepage-header__section {
    max-width: 100%;
    overflow: hidden;
    height: 556px;
    position: relative;
  }

  .homepage-background__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .homepage-header__section h1 {
    color: var(--color-foreground-heading);
    margin-bottom: 0;
  }

  .homepage-headings {
    padding: 0 2rem;
    position: absolute;
    bottom: 48px;
    /* transform: translateY(-50%); */
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .homepage-headings h3 {
    color: var(--color-foreground);
  }

  .homepage-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media screen and (min-width: 750px) {
    .homepage-buttons {
      flex-direction: row;
    }

    .homepage-header__section {
      height: 887px;
    }

    .homepage-headings {
      padding: 0;
      margin-left: 120px;
      bottom: 120px;
      max-width: 714px;
    }
  }
{%- endstylesheet -%}

<div class="homepage-header__section color-{{ section.settings.color_scheme }}">
  {%- if section.settings.background_img != blank -%}
    {{
      section.settings.background_img
      | image_url: width: 904, height: 556
      | image_tag: class: 'homepage-background__img', loading: 'eager'
    }}
  {%- endif -%}

  <div class="homepage-headings">
    {%- if section.settings.heading != blank -%}
      <h1>
        {{ section.settings.heading }}
      </h1>
    {%- endif -%}

    <p>{{ section.settings.subheading }}</p>

    <div class="homepage-buttons">{% content_for 'blocks' %}</div>
  </div>
</div>

{% schema %}
{
  "name": "Homepage Top Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_img",
      "label": "Background Image"
    },
    {
      "type": "color_scheme",
      "label": "t:settings.color_scheme",
      "id": "color_scheme"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "Train Hard. Get Strong. Join the Community."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading Text",
      "default": "At CrossFit Claremont, we help people of all ages and fitness levels become stronger, fitter, and more confident through expert coaching and supportive group training."
    }
  ],
  "blocks": [
    {
      "type": "button"
    }
  ],
  "presets": [
    {
      "name": "Homepage Top Section"
    }
  ]
}
{% endschema %}
