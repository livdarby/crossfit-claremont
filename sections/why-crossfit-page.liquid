<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="why-crossfit-page color-{{ section.settings.color_scheme }}"
  style="
    {% render 'prefixed-typography-style', settings: section.settings, prefix: 'body_heading_', type: 'heading', css_var_prefix: 'why-body-heading' %}
    {% render 'prefixed-typography-style', settings: section.settings, prefix: 'body_copy_', type: 'body', css_var_prefix: 'why-body-copy' %}
  "
>
  <div
    class="section section--page-width spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="why-crossfit-page__cards">
      {% for block in section.blocks %}
        {% liquid
          assign card_image_alt = block.settings.heading
          if block.settings.image != blank and block.settings.image.alt != blank
            assign card_image_alt = block.settings.image.alt
          endif
        %}
        <article
          class="why-crossfit-page__card"
          {{ block.shopify_attributes }}
        >
          <div class="why-crossfit-page__card-media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'why-crossfit-page__card-image',
                  widths: '480, 720, 960, 1200',
                  sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: card_image_alt
              }}
            {% else %}
              <div class="why-crossfit-page__card-placeholder"></div>
            {% endif %}
          </div>

          {% if block.settings.heading != blank %}
            <h2
              class="why-crossfit-page__card-title"
              style="{% render 'prefixed-typography-style', settings: section.settings, prefix: 'card_heading_', type: 'heading' %}"
            >
              {{ block.settings.heading }}
            </h2>
          {% endif %}

          {% if block.settings.copy != blank %}
            <div
              class="why-crossfit-page__card-copy rte"
              style="{% render 'prefixed-typography-style', settings: section.settings, prefix: 'card_copy_', type: 'body' %}"
            >
              {{ block.settings.copy }}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>

    {% if page.content != blank %}
      <div class="why-crossfit-page__body rte">
        {{ page.content }}
      </div>
    {% endif %}

    <div class="why-crossfit-page__mission">
      {% liquid
        assign mission_image_alt = page_title
        if section.settings.hero_image != blank and section.settings.hero_image.alt != blank
          assign mission_image_alt = section.settings.hero_image.alt
        endif
      %}
      <div class="why-crossfit-page__mission-media">
        {% if section.settings.hero_image != blank %}
          {{
            section.settings.hero_image
            | image_url: width: 2200
            | image_tag:
              class: 'why-crossfit-page__mission-image',
              widths: '720, 1200, 1600, 2200',
              sizes: '100vw',
              loading: 'lazy',
              alt: mission_image_alt
          }}
        {% endif %}
        <div class="why-crossfit-page__mission-overlay"></div>
      </div>

      <div class="why-crossfit-page__mission-content">
        {% if section.settings.mission_eyebrow != blank %}
          <p
            class="why-crossfit-page__mission-eyebrow"
            style="{% render 'prefixed-typography-style', settings: section.settings, prefix: 'mission_eyebrow_', type: 'body' %}"
          >
            {{ section.settings.mission_eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.mission_heading != blank %}
          <h2
            class="why-crossfit-page__mission-heading {{ section.settings.mission_heading_type_preset }} {{ section.settings.mission_heading_type_preset }}"
            style="--color: {{ section.settings.mission_heading_color }};"
          >
            {{ section.settings.mission_heading }}
          </h2>
        {% endif %}

        {% if section.settings.mission_copy != blank %}
          <div
            class="why-crossfit-page__mission-copy rte"
            style="{% render 'prefixed-typography-style', settings: section.settings, prefix: 'mission_copy_', type: 'body' %}"
          >
            {{ section.settings.mission_copy }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .why-crossfit-page__intro {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .why-crossfit-page__title,
  .why-crossfit-page__card-title,
  .why-crossfit-page__mission-heading {
    margin: 0;
    font-family: var(--font-family, var(--font-heading--family));
    color: var(--color, var(--color-foreground-heading));
    line-height: var(--line-height, normal);
    letter-spacing: var(--letter-spacing, 0);
    text-transform: var(--text-transform, none);
    text-wrap: var(--text-wrap, pretty);
  }

  .why-crossfit-page__title {
    font-size: var(--font-size, clamp(3rem, 7vw, 5.5rem));
  }

  .why-crossfit-page__cards {
    display: grid;
    gap: 1.5rem;
    align-items: stretch;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .why-crossfit-page__card {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 0.85rem;
    height: 100%;
  }

  .why-crossfit-page__card-media {
    overflow: hidden;
    border-radius: 14px;
    aspect-ratio: 4 / 5;
    background: rgb(var(--color-foreground-rgb) / 0.08);
  }

  .why-crossfit-page__card-image,
  .why-crossfit-page__mission-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .why-crossfit-page__card-placeholder {
    width: 100%;
    height: 100%;
    background: rgb(var(--color-foreground-rgb) / 0.08);
  }

  .why-crossfit-page__card-title {
    font-size: var(--font-size, clamp(2rem, 4vw, 2.8rem));
  }

  .why-crossfit-page__card-copy,
  .why-crossfit-page__mission-copy {
    color: rgb(var(--color-foreground-rgb) / 0.82);
  }

  .why-crossfit-page__card-copy {
    font-family: var(--font-family, var(--font-body--family));
    font-size: var(--font-size, 1rem);
    line-height: var(--line-height, 1.65);
    letter-spacing: var(--letter-spacing, normal);
    text-transform: var(--text-transform, none);
    text-wrap: var(--text-wrap, pretty);
    color: var(--color, rgb(var(--color-foreground-rgb) / 0.82));
    height: 100%;
  }

  .why-crossfit-page__card-copy p,
  .why-crossfit-page__mission-copy p {
    line-height: var(--font-paragraph--line-height);
  }

  .why-crossfit-page__card-copy > *:first-child,
  .why-crossfit-page__mission-copy > *:first-child {
    margin-top: 0;
  }

  .why-crossfit-page__card-copy > *:last-child,
  .why-crossfit-page__mission-copy > *:last-child {
    margin-bottom: 0;
  }

  .why-crossfit-page__mission {
    position: relative;
    overflow: hidden;
    min-height: 38rem;
    border-radius: 0;
    background: #111;
  }

  .why-crossfit-page__body {
    max-width: 54rem;
    margin: 0 0 clamp(3rem, 6vw, 5rem);
    color: var(--why-body-copy-color, rgb(var(--color-foreground-rgb) / 0.82));
    font-family: var(--why-body-copy-font-family, var(--font-body--family));
    font-size: var(--why-body-copy-font-size, 1rem);
    line-height: 25.6px;
    letter-spacing: var(--why-body-copy-letter-spacing, normal);
    text-transform: var(--why-body-copy-text-transform, none);
    text-wrap: var(--why-body-copy-text-wrap, pretty);
  }

  .why-crossfit-page__body :is(h2, h3, h4) {
    font-family: var(--why-body-heading-font-family, var(--font-heading--family));
    font-size: var(--why-body-heading-font-size, 2rem);
    color: var(--why-body-heading-color, var(--color-foreground-heading));
    line-height: var(--why-body-heading-line-height, 0.98);
    letter-spacing: var(--why-body-heading-letter-spacing, 0);
    text-transform: var(--why-body-heading-text-transform, none);
    text-wrap: var(--why-body-heading-text-wrap, pretty);
  }

  .why-crossfit-page__mission-media,
  .why-crossfit-page__mission-overlay {
    position: absolute;
    inset: 0;
  }

  .why-crossfit-page__mission-overlay {
    background: linear-gradient(90deg, rgb(17 17 17 / 0.18), rgb(17 17 17 / 0.68));
  }

  .why-crossfit-page__mission-content {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    color: #fff;
  }

  .why-crossfit-page__mission-eyebrow {
    margin: 0;
    font-family: var(--font-family, var(--font-heading--family));
    font-size: var(--font-size, clamp(1.2rem, 2vw, 1.6rem));
    line-height: var(--line-height, normal);
    letter-spacing: var(--letter-spacing, normal);
    text-transform: var(--text-transform, none);
    text-wrap: var(--text-wrap, pretty);
    color: var(--color, #bb35ff);
  }

  .why-crossfit-page__mission-heading {
    max-width: 14ch;
    color: var(--color, #fff);
  }

  .why-crossfit-page__mission-copy {
    max-width: 34rem;
    font-family: var(--font-family, var(--font-body--family));
    font-size: var(--font-size, 1.05rem);
    line-height: var(--line-height, 1.7);
    letter-spacing: var(--letter-spacing, normal);
    text-transform: var(--text-transform, none);
    text-wrap: var(--text-wrap, pretty);
    color: var(--color, rgb(255 255 255 / 0.92));
  }

  @media screen and (min-width: 750px) {
    .why-crossfit-page__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .why-crossfit-page__card-copy {
      font-size: 1.1rem;
    }

    .why-crossfit-page__body {
      font-size: 1.1rem;
    }

    .why-crossfit-page__mission-content {
      min-height: 38rem;
      align-content: center;
      justify-items: end;
      margin-left: auto;
      max-width: min(58%, 56rem);
      text-align: right;
    }

    .why-crossfit-page__mission-copy {
      margin-left: auto;
    }
  }

  @media screen and (min-width: 990px) {
    .why-crossfit-page__cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
{% endstylesheet %}

