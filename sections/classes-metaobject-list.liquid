{% liquid
  assign class_entries = shop.metaobjects.classes.values
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<section
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    classes-metaobject-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank %}
    <div class="classes-metaobject-list__header">
      {% if section.settings.eyebrow != blank %}
        <p class="classes-metaobject-list__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2
          class="classes-metaobject-list__heading {{ section.settings.heading_type_preset }}"
          style="--color: {{ section.settings.heading_color }};"
        >
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="classes-metaobject-list__subheading rte">
          {{ section.settings.subheading }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  {% assign visible_item_count = 0 %}

  <div class="classes-metaobject-list__grid">
    {% if class_entries != blank %}
      {% for class_entry in class_entries %}
        {% liquid
          assign description_field_object = class_entry.description
          assign description_content = blank

          if description_field_object != blank
            if description_field_object.type == 'rich_text_field'
              assign description_content = description_field_object | metafield_tag
            else
              assign description_content = description_field_object.value | default: description_field_object
            endif
          endif

          assign description_plain = description_content | strip_html | strip
          assign class_name = class_entry.name.value | default: class_entry.name | default: class_entry.system.handle | replace: '-', ' ' | capitalize
        %}

        {% if description_plain != blank %}
          {% assign visible_item_count = visible_item_count | plus: 1 %}

          <article class="classes-metaobject-list__item">
            <h3 class="classes-metaobject-list__item-title">
              {{ class_name }}
            </h3>
            <div class="classes-metaobject-list__item-copy rte">
              {{ description_content }}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>

  {% if visible_item_count == 0 and request.design_mode %}
    <div class="classes-metaobject-list__empty rte">
      <p>No `classes` entries with a description are visible to the storefront.</p>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .classes-metaobject-list__header {
    max-width: 44rem;
  }

  .classes-metaobject-list__eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading--family);
    font-size: 0.875rem;
    line-height: var(--font-paragraph--line-height);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  .classes-metaobject-list__heading {
    margin: 0;
    color: var(--color, var(--color-foreground-heading));
  }

  .classes-metaobject-list__subheading {
    max-width: 40rem;
    color: rgb(var(--color-foreground-rgb) / 0.82);
  }

  .classes-metaobject-list__subheading > *:first-child,
  .classes-metaobject-list__item-copy > *:first-child,
  .classes-metaobject-list__empty > *:first-child {
    margin-top: 0;
  }

  .classes-metaobject-list__subheading > *:last-child,
  .classes-metaobject-list__item-copy > *:last-child,
  .classes-metaobject-list__empty > *:last-child {
    margin-bottom: 0;
  }

  .classes-metaobject-list__grid {
    display: grid;
    gap: var(--gap);
  }

  .classes-metaobject-list__item {
    display: grid;
    gap: calc(var(--gap) * 0.5);
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
  }

  .classes-metaobject-list__item-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: var(--line-height--heading-tight);
    letter-spacing: var(--letter-spacing--heading-normal);
    color: var(--color-foreground-heading);
    text-wrap: balance;
  }

  .classes-metaobject-list__item-copy {
    max-width: 40rem;
    color: rgb(var(--color-foreground-rgb) / 0.82);
  }

  .classes-metaobject-list__item-copy p {
    line-height: var(--font-paragraph--line-height);
  }

  @media screen and (min-width: 750px) {
    .classes-metaobject-list__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Classes Metaobject List",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Class Guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our Classes"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Each class is designed to build strength, fitness, and confidence. Descriptions are pulled directly from your classes metaobjects.</p>"
    },
    {
      "type": "select",
      "id": "heading_type_preset",
      "label": "Heading preset",
      "options": [
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "h4", "label": "Heading 4" },
        { "value": "h5", "label": "Heading 5" },
        { "value": "h6", "label": "Heading 6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_color",
      "label": "Heading color",
      "options": [
        { "value": "var(--color-foreground)", "label": "Text" },
        { "value": "var(--color-foreground-heading)", "label": "Heading" },
        { "value": "var(--color-link)", "label": "Link" }
      ],
      "default": "var(--color-foreground-heading)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Classes Metaobject List",
      "category": "Text"
    }
  ]
}
{% endschema %}
