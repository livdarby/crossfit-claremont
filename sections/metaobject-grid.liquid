{% liquid
  assign max_items = section.settings.entry_limit
  assign metaobject_type = section.settings.metaobject_type | strip

  assign metaobject_entries = blank
  if metaobject_type != blank and shop.metaobjects[metaobject_type] != blank
    assign metaobject_entries = shop.metaobjects[metaobject_type].values
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    metaobject-grid
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    {%- render 'gap-style', value: section.settings.gap -%}
    --metaobject-grid-columns: {{ section.settings.columns }};
    --metaobject-grid-desktop-grid-gap: {{ section.settings.desktop_gap }}px;
    --metaobject-grid-desktop-section-gap: {{ section.settings.desktop_section_gap }}px;
  "
>
  {% content_for 'block', id: 'static-metaobject-title', type: '_metaobject-grid-title' %}

  {% capture list_items %}
    {% if metaobject_entries != blank %}
      {% for metaobject_entry in metaobject_entries limit: max_items %}
        <div class="resource-list__item">
          {% content_for 'block',
            id: 'static-metaobject-card',
            type: '_metaobject-grid-card',
            metaobject_entry: metaobject_entry
          %}
        </div>
        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% else %}
      {% for i in (1..max_items) %}
        <div class="resource-list__item">
          {% content_for 'block',
            id: 'static-metaobject-card',
            type: '_metaobject-grid-card',
            metaobject_entry: blank
          %}
        </div>
        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    carousel_ref: 'metaobjectGrid',
    slide_count: max_items,
    content_type: 'collections',
    test_id: 'metaobject-grid'
  %}
</div>

{% stylesheet %}
  @media screen and (min-width: 769px) {
    .metaobject-grid.section-resource-list {
      row-gap: var(--metaobject-grid-desktop-section-gap);
    }

    .metaobject-grid .resource-list--grid[data-testid='metaobject-grid'] {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: flex-start;
      align-content: flex-start;
      gap: var(--metaobject-grid-desktop-grid-gap);
    }

    .metaobject-grid .resource-list--grid[data-testid='metaobject-grid'] > .resource-list__item {
      flex: 0 0
        calc(
          (100% - (var(--metaobject-grid-columns) - 1) * var(--metaobject-grid-desktop-grid-gap)) /
            var(--metaobject-grid-columns)
        );
      max-width: calc(
        (100% - (var(--metaobject-grid-columns) - 1) * var(--metaobject-grid-desktop-grid-gap)) /
          var(--metaobject-grid-columns)
      );
      height: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Metaobject: Grid",
  "tag": "section",
  "class": "metaobject-grid-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_metaobject-grid-title"
    },
    {
      "type": "_metaobject-grid-card"
    },
    {
      "type": "_metaobject-grid-image"
    },
    {
      "type": "_metaobject-grid-description"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "metaobject_type",
      "label": "Metaobject definition handle",
      "info": "Use the metaobject type/definition handle, for example team_member or faq_item."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "range",
      "id": "entry_limit",
      "label": "Entries to show",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "title_field",
      "label": "Title field handle",
      "default": "title"
    },
    {
      "type": "text",
      "id": "description_field",
      "label": "Description field handle",
      "default": "description"
    },
    {
      "type": "text",
      "id": "image_field",
      "label": "Image field handle",
      "default": "image"
    },
    {
      "type": "text",
      "id": "link_field",
      "label": "Link field handle",
      "default": "link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout type",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "Carousel on mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "Mobile card size",
      "options": [
        {
          "value": "60cqw",
          "label": "1 per view"
        },
        {
          "value": "44cqw",
          "label": "2 per view"
        }
      ],
      "default": "60cqw",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Horizontal gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop grid gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "range",
      "id": "desktop_section_gap",
      "label": "Desktop section gap",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "Vertical gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "Carousel navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Icon",
      "options": [
        {
          "value": "arrow",
          "label": "Arrows"
        },
        {
          "value": "chevron",
          "label": "Chevrons"
        },
        {
          "value": "arrows_large",
          "label": "Large arrows"
        },
        {
          "value": "chevron_large",
          "label": "Large chevrons"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Icon background",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Section gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Metaobject: Grid",
      "category": "Storytelling",
      "blocks": {
        "static-metaobject-title": {
          "type": "_metaobject-grid-title",
          "name": "Title",
          "static": true,
          "settings": {
            "text": "<h3>Metaobject grid</h3>",
            "type_preset": "rte"
          }
        },
        "static-metaobject-card": {
          "type": "_metaobject-grid-card",
          "name": "Metaobject card",
          "static": true,
          "settings": {},
          "blocks": {
            "image": {
              "type": "_metaobject-grid-image",
              "name": "Image",
              "static": true,
              "settings": {
                "image_ratio": "square"
              }
            },
            "title": {
              "type": "_heading",
              "name": "Title",
              "static": true,
              "settings": {
                "text": "<h4>Metaobject title</h4>",
                "show_alignment": false
              }
            },
            "description": {
              "type": "_metaobject-grid-description",
              "name": "Description",
              "static": true,
              "settings": {
                "padding-block-start": 8,
                "padding-block-end": 0
              }
            }
          }
        }
      },
      "settings": {
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "entry_limit": 6,
        "columns": 3,
        "mobile_columns": "1",
        "columns_gap": 16,
        "rows_gap": 16,
        "gap": 12,
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    }
  ]
}
{% endschema %}
