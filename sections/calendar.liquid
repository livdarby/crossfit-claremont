<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    calendar-section
    spacing-style
    gap-style
  "
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    {%- render 'gap-style', value: section.settings.gap -%}
  "
>
  {% if section.settings.heading != blank or section.settings.subheading != blank %}
    <div class="calendar-section__header">
      {% if section.settings.heading != blank %}
        <h2 class="calendar-section__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="calendar-section__subheading rte">{{ section.settings.subheading }}</div>
      {% endif %}
    </div>
  {% endif %}

  <div class="calendar-table-wrapper">
    <div class="calendar-table" role="table" aria-label="{{ section.settings.heading | default: 'Calendar' }}">
      <div class="calendar-table__row calendar-table__row--head" role="row">
        <div class="calendar-table__cell calendar-table__cell--head calendar-table__cell--time" role="columnheader">
          {{ section.settings.time_heading }}
        </div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">{{ section.settings.day_1 }}</div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">{{ section.settings.day_2 }}</div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">{{ section.settings.day_3 }}</div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">{{ section.settings.day_4 }}</div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">{{ section.settings.day_5 }}</div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">{{ section.settings.day_6 }}</div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">{{ section.settings.day_7 }}</div>
      </div>

      {% for block in section.blocks %}
        <div class="calendar-table__row" role="row" {{ block.shopify_attributes }}>
          <div class="calendar-table__cell calendar-table__cell--time" role="rowheader">
            {{ block.settings.time_label }}
          </div>
          <div class="calendar-table__cell rte" role="cell">{{ block.settings.day_1 }}</div>
          <div class="calendar-table__cell rte" role="cell">{{ block.settings.day_2 }}</div>
          <div class="calendar-table__cell rte" role="cell">{{ block.settings.day_3 }}</div>
          <div class="calendar-table__cell rte" role="cell">{{ block.settings.day_4 }}</div>
          <div class="calendar-table__cell rte" role="cell">{{ block.settings.day_5 }}</div>
          <div class="calendar-table__cell rte" role="cell">{{ block.settings.day_6 }}</div>
          <div class="calendar-table__cell rte" role="cell">{{ block.settings.day_7 }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .calendar-section__header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs);
  }

  .calendar-section__heading {
    margin: 0;
  }

  .calendar-section__subheading > *:first-child {
    margin-top: 0;
  }

  .calendar-section__subheading > *:last-child {
    margin-bottom: 0;
  }

  .calendar-table-wrapper {
    overflow-x: auto;
  }

  .calendar-table {
    display: grid;
    min-width: 900px;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-left: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .calendar-table__row {
    display: grid;
    grid-template-columns: minmax(120px, 1.1fr) repeat(7, minmax(120px, 1fr));
  }

  .calendar-table__cell {
    padding: 1rem;
    border-right: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    min-height: 84px;
    /* background: rgb(var(--color-background-rgb)); */
  }

  .calendar-table__cell--head,
  .calendar-table__cell--time {
    font-weight: 600;
  }

  .calendar-table__cell--head {
    min-height: auto;
    /* background: rgb(var(--color-foreground-rgb) / 0.04); */
  }

  .calendar-table__cell--time {
    /* background: rgb(var(--color-foreground-rgb) / 0.025); */
  }

  .calendar-table__cell > *:first-child {
    margin-top: 0;
  }

  .calendar-table__cell > *:last-child {
    margin-bottom: 0;
  }

  .calendar-table__cell.rte > p {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0.35rem 0.7rem;
    border-radius: var(--style-border-radius-pills);
    background-color: var(--color-variant-background);
    color: var(--color-variant-text);
  }
{% endstylesheet %}

