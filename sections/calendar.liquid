<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    calendar-section
    spacing-style
    gap-style
  "
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    {%- render 'gap-style', value: section.settings.gap -%}
  "
>
  {% if section.settings.heading != blank or section.settings.subheading != blank %}
    <div class="calendar-section__header">
      {% if section.settings.heading != blank %}
        <h2 class="calendar-section__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="calendar-section__subheading rte">{{ section.settings.subheading }}</div>
      {% endif %}
    </div>
  {% endif %}

  <div class="calendar-table-wrapper">
    <div class="calendar-table" role="table" aria-label="{{ section.settings.heading | default: 'Calendar' }}">
      <div class="calendar-table__row calendar-table__row--head" role="row">
        <div class="calendar-table__cell calendar-table__cell--head calendar-table__cell--time" role="columnheader">
          {{ section.settings.time_heading }}
        </div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">
          {{ section.settings.day_1 }}
        </div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">
          {{ section.settings.day_2 }}
        </div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">
          {{ section.settings.day_3 }}
        </div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">
          {{ section.settings.day_4 }}
        </div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">
          {{ section.settings.day_5 }}
        </div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">
          {{ section.settings.day_6 }}
        </div>
        <div class="calendar-table__cell calendar-table__cell--head" role="columnheader">
          {{ section.settings.day_7 }}
        </div>
      </div>

      {% for block in section.blocks %}
        {% liquid
          assign day_1_class = block.settings.day_1_class
          assign day_1_name = day_1_class['name'].value | default: day_1_class.system.handle
          assign day_1_color = day_1_class['timetable_color'].value | default: day_1_class['timetable_color']
          assign day_2_class = block.settings.day_2_class
          assign day_2_name = day_2_class['name'].value | default: day_2_class.system.handle
          assign day_2_color = day_2_class['timetable_color'].value | default: day_2_class['timetable_color']
          assign day_3_class = block.settings.day_3_class
          assign day_3_name = day_3_class['name'].value | default: day_3_class.system.handle
          assign day_3_color = day_3_class['timetable_color'].value | default: day_3_class['timetable_color']
          assign day_4_class = block.settings.day_4_class
          assign day_4_name = day_4_class['name'].value | default: day_4_class.system.handle
          assign day_4_color = day_4_class['timetable_color'].value | default: day_4_class['timetable_color']
          assign day_5_class = block.settings.day_5_class
          assign day_5_name = day_5_class['name'].value | default: day_5_class.system.handle
          assign day_5_color = day_5_class['timetable_color'].value | default: day_5_class['timetable_color']
          assign day_6_class = block.settings.day_6_class
          assign day_6_name = day_6_class['name'].value | default: day_6_class.system.handle
          assign day_6_color = day_6_class['timetable_color'].value | default: day_6_class['timetable_color']
          assign day_7_class = block.settings.day_7_class
          assign day_7_name = day_7_class['name'].value | default: day_7_class.system.handle
          assign day_7_color = day_7_class['timetable_color'].value | default: day_7_class['timetable_color']
        %}
        <div class="calendar-table__row" role="row" {{ block.shopify_attributes }}>
          <div class="calendar-table__cell calendar-table__cell--time" role="rowheader">
            {{ block.settings.time_label }}
          </div>
          <div class="calendar-table__cell rte {{ day_1_name | handleize | strip }}" role="cell">
            {% if day_1_name != blank %}<p{% if day_1_color != blank %} style="background-color: {{ day_1_color }};"{% endif %}>{{ day_1_name | upcase }}</p>{% endif %}
          </div>
          <div class="calendar-table__cell rte {{ day_2_name | handleize | strip }}" role="cell">
            {% if day_2_name != blank %}<p{% if day_2_color != blank %} style="background-color: {{ day_2_color }};"{% endif %}>{{ day_2_name | upcase }}</p>{% endif %}
          </div>
          <div class="calendar-table__cell rte {{ day_3_name | handleize | strip }}" role="cell">
            {% if day_3_name != blank %}<p{% if day_3_color != blank %} style="background-color: {{ day_3_color }};"{% endif %}>{{ day_3_name | upcase }}</p>{% endif %}
          </div>
          <div class="calendar-table__cell rte {{ day_4_name | handleize | strip }}" role="cell">
            {% if day_4_name != blank %}<p{% if day_4_color != blank %} style="background-color: {{ day_4_color }};"{% endif %}>{{ day_4_name | upcase }}</p>{% endif %}
          </div>
          <div class="calendar-table__cell rte {{ day_5_name | handleize | strip }}" role="cell">
            {% if day_5_name != blank %}<p{% if day_5_color != blank %} style="background-color: {{ day_5_color }};"{% endif %}>{{ day_5_name | upcase }}</p>{% endif %}
          </div>
          <div class="calendar-table__cell rte {{ day_6_name | handleize | strip }}" role="cell">
            {% if day_6_name != blank %}<p{% if day_6_color != blank %} style="background-color: {{ day_6_color }};"{% endif %}>{{ day_6_name | upcase }}</p>{% endif %}
          </div>
          <div class="calendar-table__cell rte {{ day_7_name | handleize | strip }}" role="cell">
            {% if day_7_name != blank %}<p{% if day_7_color != blank %} style="background-color: {{ day_7_color }};"{% endif %}>{{ day_7_name | upcase }}</p>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .calendar-section__header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs);
  }

  .calendar-section__heading {
    margin: 0;
  }

  .calendar-section__subheading > *:first-child {
    margin-top: 0;
  }

  .calendar-section__subheading > *:last-child {
    margin-bottom: 0;
  }

  .calendar-table-wrapper {
    overflow-x: auto;
  }

  .calendar-table {
    display: grid;
    min-width: 900px;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-left: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .calendar-table__row {
    display: grid;
    grid-template-columns: minmax(120px, 1.1fr) repeat(7, minmax(120px, 1fr));
  }

  .calendar-table__cell {
    padding: 4px;
    border-right: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    min-height: 84px;
    /* background: rgb(var(--color-background-rgb)); */
  }

  .calendar-table__cell--head,
  .calendar-table__cell--time {
    font-weight: 600;
  }

  .calendar-table__cell--head {
    min-height: auto;
    /* background: rgb(var(--color-foreground-rgb) / 0.04); */
  }

  .calendar-table__cell--time {
    /* background: rgb(var(--color-foreground-rgb) / 0.025); */
  }

  .calendar-table__cell > *:first-child {
    margin-top: 0;
  }

  .calendar-table__cell > *:last-child {
    margin-bottom: 0;
  }

  .calendar-table__cell.rte > p {
    display: inline-flex;
    justify-content: center;
    /* align-items: center; */
    margin: 0;
    padding: 0.35rem 0.7rem;
    /* border-radius: var(--style-border-radius-pills); */
    border-radius: 5px;
    background-color: var(--color-variant-background);
    color: var(--color-variant-text);
    height: 100%;
    width: 100%;
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Calendar",
  "tag": "section",
  "class": "calendar-section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Weekly schedule"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Table headings"
    },
    {
      "type": "text",
      "id": "time_heading",
      "label": "First column heading",
      "default": "Time"
    },
    {
      "type": "text",
      "id": "day_1",
      "label": "Day 1",
      "default": "Monday"
    },
    {
      "type": "text",
      "id": "day_2",
      "label": "Day 2",
      "default": "Tuesday"
    },
    {
      "type": "text",
      "id": "day_3",
      "label": "Day 3",
      "default": "Wednesday"
    },
    {
      "type": "text",
      "id": "day_4",
      "label": "Day 4",
      "default": "Thursday"
    },
    {
      "type": "text",
      "id": "day_5",
      "label": "Day 5",
      "default": "Friday"
    },
    {
      "type": "text",
      "id": "day_6",
      "label": "Day 6",
      "default": "Saturday"
    },
    {
      "type": "text",
      "id": "day_7",
      "label": "Day 7",
      "default": "Sunday"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "time_label",
          "label": "Time label",
          "default": "6:00 AM"
        },
        {
          "type": "metaobject",
          "id": "day_1_class",
          "label": "Monday",
          "metaobject_type": "classes"
        },
        {
          "type": "metaobject",
          "id": "day_2_class",
          "label": "Tuesday",
          "metaobject_type": "classes"
        },
        {
          "type": "metaobject",
          "id": "day_3_class",
          "label": "Wednesday",
          "metaobject_type": "classes"
        },
        {
          "type": "metaobject",
          "id": "day_4_class",
          "label": "Thursday",
          "metaobject_type": "classes"
        },
        {
          "type": "metaobject",
          "id": "day_5_class",
          "label": "Friday",
          "metaobject_type": "classes"
        },
        {
          "type": "metaobject",
          "id": "day_6_class",
          "label": "Saturday",
          "metaobject_type": "classes"
        },
        {
          "type": "metaobject",
          "id": "day_7_class",
          "label": "Sunday",
          "metaobject_type": "classes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Calendar",
      "category": "Storytelling",
      "blocks": {
        "row_1": {
          "type": "row",
          "settings": {
            "time_label": "6:00 AM"
          }
        },
        "row_2": {
          "type": "row",
          "settings": {
            "time_label": "5:30 PM"
          }
        }
      }
    }
  ]
}
{% endschema %}
