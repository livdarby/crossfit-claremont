{% liquid
  assign recent_posts_count = 0
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section color-{{ section.settings.color_scheme }}">
  <div
    class="recent-blog-posts spacing-style section-content-wrapper"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% if section.settings.heading != blank %}
      <h2 class="recent-blog-posts__title">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="recent-blog-posts__grid">
      {% for recent_article in section.settings.blog.articles %}
        {% if article and recent_article.id == article.id %}
          {% continue %}
        {% endif %}
        {% if recent_posts_count >= section.settings.post_limit %}
          {% break %}
        {% endif %}

        <article class="recent-blog-post">
          <a class="recent-blog-post__image-link" href="{{ recent_article.url }}">
            {% if recent_article.image %}
              {{
                recent_article.image
                | image_url: width: 720
                | image_tag:
                  class: 'recent-blog-post__image',
                  widths: '240, 360, 480, 720',
                  sizes: '(min-width: 990px) 30vw, 100vw',
                  loading: 'lazy',
                  alt: recent_article.image.alt | default: recent_article.title
              }}
            {% endif %}
          </a>

          <div class="recent-blog-post__meta">
            <span class="recent-blog-post__date">{{ recent_article.published_at | date: '%B %d, %Y' }}</span>
          </div>

          <h3 class="recent-blog-post__heading">
            <a href="{{ recent_article.url }}">{{ recent_article.title }}</a>
          </h3>

          {% if recent_article.excerpt != blank %}
            <div class="recent-blog-post__excerpt">
              {{ recent_article.excerpt | strip_html | truncatewords: 16 }}
            </div>
          {% elsif recent_article.content != blank %}
            <p class="recent-blog-post__excerpt">
              {{ recent_article.content | strip_html | truncatewords: 16 }}
            </p>
          {% endif %}

          <a class="recent-blog-post__cta button-secondary" href="{{ recent_article.url }}">
            {{ section.settings.button_label }}
          </a>
        </article>

        {% liquid
          assign recent_posts_count = recent_posts_count | plus: 1
        %}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .recent-blog-posts {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .recent-blog-posts__title {
    margin: 0 0 1rem;
    font-family: 'Oswald';
    font-size: 32px;
    line-height: 1;
    color: var(--color-foreground-heading);
    font-weight: 500;
  }

  .recent-blog-posts__grid {
    display: grid;
    gap: 1.25rem;
  }

  .recent-blog-post {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .recent-blog-post__image-link {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    background: #ddd7cd;
  }

  .recent-blog-post__image {
    display: block;
    width: 100%;
    aspect-ratio: 1.5 / 1;
    object-fit: cover;
  }

  .recent-blog-post__meta {
    font-size: 12px;
    line-height: 1.4;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .recent-blog-post__heading {
    margin: 0;
    font-family: 'Oswald';
    font-size: 24px;
    line-height: 1.05;
    font-weight: 500;
    color: var(--color-foreground-heading);
  }

  .recent-blog-post__heading a {
    color: inherit;
    text-decoration: none;
  }

  .recent-blog-post__excerpt {
    margin: 0;
    height: 63px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    font-size: 14px;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / 0.78);
    text-overflow: ellipsis;
  }

  .recent-blog-post__cta {
    align-self: flex-start;
    min-height: auto !important;
    padding: 0.45rem 0.7rem;
    line-height: 1.2;
    box-shadow: none;
    --button-color: #530678;
    --button-border-color: #530678;
  }

  @media screen and (min-width: 750px) {
    .recent-blog-posts__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Recent blog posts",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recent News"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Post count",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View Post"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Recent blog posts"
    }
  ]
}
{% endschema %}
