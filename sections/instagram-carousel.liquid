<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div
    class="instagram-carousel-placeholder spacing-style section-content-wrapper"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="instagram-carousel-placeholder__header">
      {% if section.settings.kicker != blank %}
        <p class="instagram-carousel-placeholder__kicker">{{ section.settings.kicker }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="instagram-carousel-placeholder__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="instagram-carousel-placeholder__text rte">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <p class="instagram-carousel-placeholder__status">{{ section.settings.status_text }}</p>
    </div>

    <div class="instagram-carousel-placeholder__track" aria-label="Instagram carousel placeholder">
      {% for index in (1..5) %}
        <article class="instagram-carousel-placeholder__card">
          <div class="instagram-carousel-placeholder__image">
            {{ 'image' | placeholder_svg_tag: 'instagram-carousel-placeholder__svg' }}
          </div>

          <div class="instagram-carousel-placeholder__meta">
            <span class="instagram-carousel-placeholder__handle">{{ section.settings.handle_label }}</span>
            <span class="instagram-carousel-placeholder__dot"></span>
            <span class="instagram-carousel-placeholder__date">Post {{ index }}</span>
          </div>

          <p class="instagram-carousel-placeholder__caption">
            Placeholder Instagram content will render here once the feed is connected.
          </p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .instagram-carousel-placeholder {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .instagram-carousel-placeholder__header {
    max-width: 720px;
    margin-bottom: 1.5rem;
  }

  .instagram-carousel-placeholder__kicker {
    margin: 0 0 0.5rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #530678;
  }

  .instagram-carousel-placeholder__heading {
    margin: 0;
    font-family: 'Oswald';
    font-size: 32px;
    line-height: 1;
    font-weight: 500;
    color: var(--color-foreground-heading);
  }

  .instagram-carousel-placeholder__text {
    margin-top: 0.75rem;
    font-size: 14px;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.78);
  }

  .instagram-carousel-placeholder__status {
    display: inline-flex;
    align-items: center;
    margin: 1rem 0 0;
    padding: 0.45rem 0.7rem;
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 999px;
    font-size: 12px;
    line-height: 1.2;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .instagram-carousel-placeholder__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 280px);
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scroll-snap-type: x proximity;
  }

  .instagram-carousel-placeholder__track::-webkit-scrollbar {
    height: 8px;
  }

  .instagram-carousel-placeholder__track::-webkit-scrollbar-thumb {
    background: rgb(var(--color-foreground-rgb) / 0.16);
    border-radius: 999px;
  }

  .instagram-carousel-placeholder__card {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 0.9rem;
    border-radius: 14px;
    background: rgb(var(--color-background-rgb) / 0.72);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    scroll-snap-align: start;
  }

  .instagram-carousel-placeholder__image {
    overflow: hidden;
    border-radius: 10px;
    aspect-ratio: 1 / 1;
    background: #e6dfd6;
  }

  .instagram-carousel-placeholder__svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .instagram-carousel-placeholder__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 12px;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .instagram-carousel-placeholder__handle {
    font-weight: 600;
    color: var(--color-foreground-heading);
  }

  .instagram-carousel-placeholder__dot {
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb) / 0.35);
  }

  .instagram-carousel-placeholder__caption {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / 0.78);
  }

  @media screen and (min-width: 750px) {
    .instagram-carousel-placeholder__heading {
      font-size: 40px;
    }

    .instagram-carousel-placeholder__track {
      grid-auto-columns: minmax(260px, 300px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Instagram carousel",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Instagram"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Instagram Carousel"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>This is a placeholder section showing where the live Instagram feed carousel will appear once the app is connected.</p>"
    },
    {
      "type": "text",
      "id": "status_text",
      "label": "Status text",
      "default": "Placeholder only until the Instagram app feed is connected"
    },
    {
      "type": "text",
      "id": "handle_label",
      "label": "Handle label",
      "default": "@crossfitclaremont"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Instagram carousel"
    }
  ]
}
{% endschema %}
