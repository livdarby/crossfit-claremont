{% assign render_url = 'https://wod-auth.onrender.com' %}

<div id="wod-gate" class="wod-gate color-{{ section.settings.color_scheme }}" aria-hidden="true">
  <div class="wod-gate__inner">
    <h2>Members Area</h2>
    <p>Enter the WOD password to continue.</p>

    <form id="wod-gate-form">
      <input id="wod-password" type="password" placeholder="Password" required>
      <button type="submit" class="button wod-gate__submit">
        <span class="wod-gate__submit-label">Unlock</span>
        <span class="wod-gate__spinner" aria-hidden="true"></span>
      </button>
    </form>

    <div id="wod-error" class="wod-error">Incorrect password.</div>
  </div>
</div>
<div id="wod-gate-overlay" class="wod-gate-overlay" aria-hidden="true"></div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const gate = document.getElementById('wod-gate');
    const overlay = document.getElementById('wod-gate-overlay');
    const content = document.getElementById('wod-content');
    const pageContent = document.getElementById('wod-page-content');
    const error = document.getElementById('wod-error');
    const form = document.getElementById('wod-gate-form');
    const passwordInput = document.getElementById('wod-password');
    const submitButton = form.querySelector('button[type="submit"]');
    const skeletonMarkup = `
      <div class="wod-content-skeleton" aria-hidden="true">
        <div class="wod-content-skeleton__intro">
          <span class="wod-content-skeleton__line wod-content-skeleton__line--short"></span>
          <span class="wod-content-skeleton__line wod-content-skeleton__line--medium"></span>
          <span class="wod-content-skeleton__line wod-content-skeleton__line--long"></span>
        </div>
        <div class="wod-content-skeleton__section">
          <span class="wod-content-skeleton__heading"></span>
          <div class="wod-content-skeleton__card">
            <span class="wod-content-skeleton__line wod-content-skeleton__line--long"></span>
            <span class="wod-content-skeleton__line wod-content-skeleton__line--long"></span>
            <span class="wod-content-skeleton__line wod-content-skeleton__line--medium"></span>
          </div>
        </div>
        <div class="wod-content-skeleton__section">
          <span class="wod-content-skeleton__heading"></span>
          <div class="wod-content-skeleton__card">
            <span class="wod-content-skeleton__line wod-content-skeleton__line--long"></span>
            <span class="wod-content-skeleton__line wod-content-skeleton__line--medium"></span>
            <span class="wod-content-skeleton__line wod-content-skeleton__line--short"></span>
          </div>
        </div>
      </div>
    `;

    const currentId = {{ article.id | json }};
    const savedPassword = sessionStorage.getItem('wodPassword');

    function setGateVisibility(isVisible) {
      gate.classList.toggle('is-active', isVisible);
      gate.setAttribute('aria-hidden', String(!isVisible));
      overlay.setAttribute('aria-hidden', String(!isVisible));
      pageContent?.classList.toggle('wod-page-content--locked', isVisible);
      document.body.classList.toggle('wod-gate-open', isVisible);
    }

    function setLoadingState(isLoading) {
      gate.classList.toggle('is-loading', isLoading);
      gate.setAttribute('aria-busy', String(isLoading));
      passwordInput.disabled = isLoading;
      submitButton.disabled = isLoading;
    }

    function setContentLoading(isLoading) {
      content.classList.toggle('is-loading', isLoading);

      if (isLoading) {
        content.innerHTML = skeletonMarkup;
        return;
      }

      if (content.querySelector('.wod-content-skeleton')) {
        content.innerHTML = '';
      }
    }

    async function loadWodContent(password) {
      setLoadingState(true);
      setContentLoading(true);

      try {
        const response = await fetch('{{ render_url }}/wod-content', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            password,
            articleId: currentId,
          }),
        });

        const data = await response.json();

        if (!response.ok || !data.allowed) {
          throw new Error(data.message || 'Incorrect password');
        }

        setGateVisibility(false);

        const bodyHtml = data.article.body_html
          ? `
              <div class="blog-post-body">
                  ${data.article.body_html}
              </div>
          `
          : '';

        const programsHtml = (data.article.programs || [])
          .map(
            (program) => `
              <section class="wod-program-section">
                <h2 class="wod-program-section__title">
                  ${program.title}
                </h2>

                <div class="wod-program-section__card">
                  <div class="metafield-rich_text_field">
                    ${program.html}
                  </div>
                </div>
              </section>
            `
          )
          .join('');

        content.innerHTML = `
          ${bodyHtml}
          <div class="wod-program-sections">
            ${programsHtml}
          </div>
        `;

        // Recreate the intro paragraphs exactly like your original theme
        document.querySelectorAll('.wod-program-section').forEach((section) => {
          const card = section.querySelector('.wod-program-section__card');
          const richText = card?.querySelector('.metafield-rich_text_field');

          if (!card || !richText) return;

          let introContainer = section.querySelector('.wod-program-section__intro');

          const children = Array.from(richText.children);
          let encounteredStructuredContent = false;

          children.forEach((node) => {
            const isParagraph = node.tagName === 'P';
            const isPlainParagraph = isParagraph && !node.querySelector('strong, b');
            const isEmptyParagraph = isParagraph && node.textContent.trim() === '';
            const isStructuredBlock =
              node.querySelector?.('strong, b') ||
              node.tagName === 'UL' ||
              node.tagName === 'OL';

            if (isStructuredBlock) {
              encounteredStructuredContent = true;
            }

            if (
              encounteredStructuredContent ||
              !isPlainParagraph ||
              isEmptyParagraph
            ) {
              return;
            }

            if (!introContainer) {
              introContainer = document.createElement('div');
              introContainer.className = 'wod-program-section__intro';
              section.insertBefore(introContainer, card);
            }

            introContainer.appendChild(node);
          });
        });
      } finally {
        setLoadingState(false);
        content.classList.remove('is-loading');
      }
    }

    setGateVisibility(true);

    if (savedPassword) {
      loadWodContent(savedPassword).catch(() => {
        sessionStorage.removeItem('wodPassword');
        setContentLoading(false);
        setGateVisibility(true);
      });

      return;
    }

    document
      .getElementById('wod-gate-form')
      .addEventListener('submit', async (e) => {
        e.preventDefault();

        error.style.display = 'none';

        const password = document.getElementById('wod-password').value;

        try {
          await loadWodContent(password);
          sessionStorage.setItem('wodPassword', password);
        } catch (err) {
          setContentLoading(false);
          setGateVisibility(true);
          error.style.display = 'block';
        }
      });
  });
</script>
