{% liquid
  assign pricing_label = label | strip
  assign normalized_label = pricing_label | downcase
%}

{% if pricing_label == blank %}
  &nbsp;
{% elsif normalized_label contains 'unlimited' %}
  <span class="pricing-column-label">{{ pricing_label }}</span>
{% else %}
  <span class="pricing-column-label">
    <span class="pricing-column-label__main">{{ pricing_label }}</span>
    <span class="pricing-column-label__suffix">per week</span>
  </span>
{% endif %}
